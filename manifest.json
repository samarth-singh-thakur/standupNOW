{
  "manifest_version": 3,
  "name": "StandupNOW",
  "version": "1.0.0",
  "description": "Quick standup notes tracker - jot down your daily standup updates",
  "action": {
    "default_popup": "index.html",
    "default_title": "StandupNOW"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "background": {
    "service_worker": "src/js/background.js"
  },
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  }
}